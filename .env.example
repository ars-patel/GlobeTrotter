# Copy to .env and fill with your credentials

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/globetrotter
JWT_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nodemailer SMTP (password reset emails)
# Gmail: smtp.gmail.com, port 465, App Password (not your normal password)
# Keep SMTP_FROM address aligned with SMTP_USER to reduce spam filtering
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="GlobeTrotter <your-email@gmail.com>"
SMTP_REPLY_TO=your-email@gmail.com
